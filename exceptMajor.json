{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "./base"
  ],
  "packageRules": [
    {
      "groupName": "all non-major updates",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "lockFileMaintenance",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "groupName": "python",
      "automerge": false
    },
    {
      "description": "Digest-only python image bumps are safe to automerge; keep major/minor/tag changes manual.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "actions/checkout"
      ],
      "groupName": "actions/checkout",
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "automerge": true
  }
}